---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <section class="py-28">
    <p class="font-mono text-sm text-accent">$ curl -I &lt;this page&gt;</p>
    <h1 class="mt-3 font-mono text-4xl font-bold">HTTP/1.1 404 Not Found</h1>
    <p class="mt-4 text-muted">This page does not exist, or it moved.</p>
    <a href="/" class="mt-8 inline-block rounded bg-accent px-5 py-2.5 font-semibold text-bg hover:opacity-90">Back to home</a>
  </section>
</Base>
