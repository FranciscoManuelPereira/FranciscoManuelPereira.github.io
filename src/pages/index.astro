---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { getCollection } from 'astro:content';
import { profile, services, projects } from '../data/profile';

const writeups = (await getCollection('writeups', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="py-20 sm:py-28">
    <p class="font-mono text-sm text-accent">$ whoami</p>
    <h1 class="mt-3 text-4xl font-bold sm:text-5xl">{profile.name}</h1>
    <p class="mt-2 text-xl text-accent-2">{profile.role}</p>
    <p class="mt-6 max-w-2xl text-lg text-muted">{profile.tagline}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#contact" class="rounded bg-accent px-5 py-2.5 font-semibold text-bg hover:opacity-90">Work with me</a>
      <a href="/cv/" class="rounded border border-border px-5 py-2.5 font-semibold hover:border-accent">View CV</a>
    </div>
  </section>

  <Section id="about" title="About">
    <div class="grid gap-8 md:grid-cols-[2fr_1fr]">
      <div class="space-y-4 text-muted leading-relaxed">
        {profile.about.map((p) => <p>{p}</p>)}
      </div>
      <dl class="space-y-4 text-sm">
        {Object.entries(profile.skills).map(([group, items]) => (
          <div>
            <dt class="font-mono text-accent">{group}</dt>
            <dd class="mt-1 flex flex-wrap gap-1.5">
              {items.map((s) => <span class="rounded border border-border px-2 py-0.5">{s}</span>)}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <Section id="services" title="Services">
    <ul class="grid gap-4 md:grid-cols-3">
      {services.map((s) => (
        <li class="rounded-lg border border-border bg-surface p-5">
          <h3 class="font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{s.description}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="projects" title="Projects">
    <ul class="grid gap-4 md:grid-cols-2">
      {projects.map((p) => (
        <li class="rounded-lg border border-border bg-surface p-5">
          <h3 class="font-semibold">{p.url ? <a href={p.url} class="hover:text-accent">{p.title}</a> : p.title}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{p.description}</p>
          <p class="mt-3 flex flex-wrap gap-1.5 font-mono text-xs text-accent-2">{p.tags.map((t) => <span>#{t}</span>)}</p>
          {p.repo && <a href={p.repo} class="mt-3 inline-block text-sm text-accent hover:underline" rel="noopener noreferrer">Source code →</a>}
        </li>
      ))}
    </ul>
  </Section>

  <Section id="writeups" title="Latest writeups">
    <ul class="space-y-3">
      {writeups.map((w) => (
        <li>
          <a href={`/writeups/${w.id}/`} class="group block rounded-lg border border-border p-4 hover:border-accent">
            <p class="font-mono text-xs text-muted">{w.data.date.toISOString().slice(0, 10)}</p>
            <p class="mt-1 font-semibold group-hover:text-accent">{w.data.title}</p>
            <p class="mt-1 text-sm text-muted">{w.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
    <a href="/writeups/" class="mt-4 inline-block text-sm text-accent hover:underline">All writeups →</a>
  </Section>

  <Section id="contact" title="Contact">
    <p class="max-w-2xl text-muted">Need a security review of your web application, or a website built securely from the start? Get in touch.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`mailto:${profile.email}`} class="rounded bg-accent px-5 py-2.5 font-semibold text-bg hover:opacity-90">{profile.email}</a>
      <a href={profile.links.linkedin} class="rounded border border-border px-5 py-2.5 font-semibold hover:border-accent" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </Section>
</Base>
