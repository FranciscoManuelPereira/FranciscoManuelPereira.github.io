---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description = profile.tagline, type = 'website', noindex = false } = Astro.props;
const ogImage = new URL('/og.png', Astro.site);
// Structured data for search engines. JSON-LD is a data block, not executed, so the CSP does not block it.
const personLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Lisbon', addressCountry: 'PT' },
  sameAs: [profile.links.github, profile.links.linkedin],
});
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// GitHub Pages cannot send custom HTTP headers, so the policy is delivered with a meta tag.
// The site ships no inline scripts or styles, which keeps the policy strict.
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self' mailto:",
  'upgrade-insecure-requests',
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0f14" />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex" />}
    {!title && <script type="application/ld+json" set:html={personLd} />}
  </head>
  <body class="min-h-screen bg-bg text-text antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:bg-accent focus:text-bg focus:px-3 focus:py-2 focus:rounded">Skip to content</a>
    <Header />
    <main id="main" class="mx-auto max-w-5xl px-4 sm:px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
