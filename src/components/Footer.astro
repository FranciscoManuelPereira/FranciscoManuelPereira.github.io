---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border">
  <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-2 px-4 py-6 text-sm text-muted sm:px-6">
    <p>© {year} {profile.name}</p>
    <p class="flex gap-4">
      <a href={profile.links.github} class="hover:text-accent" rel="noopener noreferrer">GitHub</a>
      <a href={profile.links.linkedin} class="hover:text-accent" rel="noopener noreferrer">LinkedIn</a>
    </p>
  </div>
</footer>
